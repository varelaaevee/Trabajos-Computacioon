Algoritmo Matriz2x2
    Definir matriz, i, j Como Entero
    Dimension matriz[2,2]
	
    matriz[1,1] <- 5
    matriz[1,2] <- 8
    matriz[2,1] <- 3
    matriz[2,2] <- 9
	
    Para i <- 1 Hasta 2 Hacer
        Para j <- 1 Hasta 2 Hacer
            Escribir Sin Saltar matriz[i,j], " "
        FinPara
        Escribir ""
    FinPara
FinAlgoritmo
