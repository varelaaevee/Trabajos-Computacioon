

body{
    margin: 0;
    font-family: Arial, sans-serif;

    background-color: #272525;
    background-image:url("https://i.pinimg.com/736x/45/43/35/454335a6ab160b675d05bc7afa207052.jpg");
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-repeat: no-repeat;
    color: #292333;
}


header {
    background-color: #272627;
    color: white;
    text-align: center;
    padding: 25px;
}

h1 {
    font-size: 35px;
}


h2 {
    text-align: center;
    color: #292333;
    background-color: #ffffffdd;
    padding: 15px;
    margin: 30px auto;
    width: fit-content;
    border-radius: 10px;
}


.contenedor {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
    padding: 20px;
}


.tarjeta {
    width: 260px;
    padding: 15px;
    border: 2px solid;
    border-radius: 15px;
    text-align: center;
    box-shadow: 4px 4px 10px #33333355;
}


.one-piece {
    background: linear-gradient(
        135deg,
        #D7F0FA,
        #8ACCEB,
        #B4D9EA,
        #F8E5A9
    );
    border-color: #8ACCEB;
}

.my-hero {
    background: linear-gradient(
        135deg,
        #E4F0B4,
        #B9D99C,
        #A6DDD0,
        #F8E7A9
    );
    border-color: #A6C98F;
}

.jujutsu {
    background: linear-gradient(
        135deg,
        #E6D9F0,
        #C8B2D9,
        #DCA9B9,
        #B6B0D4
    );
    border-color: #B69ACB;
}
.tarjeta img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    border-radius: 10px;
}


.tarjeta h3 {
    font-size: 22px;
    color: #292333;
}


.tarjeta p {
    font-size: 14px;
    line-height: 1.5;
}


summary {
    display: inline-block;
    padding: 10px 20px;
    color: white;
    border-radius: 8px;
    cursor: pointer;
    list-style: none;
    margin-top: 10px;
}


summary::-webkit-details-marker {
    display: none;
}

.one-piece summary,
.one-piece .informacion a {
    background-color: #527da5;
}

.my-hero summary,
.my-hero .informacion a {
    background-color: #648d59;
}

.jujutsu summary,
.jujutsu .informacion a {
    background-color: #77569c;
}


.ver-menos {
    display: none;
}

details[open] .ver-mas {
    display: none;
}

details[open] .ver-menos {
    display: inline;
}

.informacion {
    background-color: #ffffffbb;
    padding: 10px;
    margin-top: 15px;
    border-radius: 10px;
}


.informacion a {
    display: inline-block;
    color: white;
    text-decoration: none;
    padding: 10px 15px;
    border-radius: 8px;
    margin: 5px;
}


.tarjeta a:hover,
summary:hover {
    opacity: 0.8;
}

footer {
    background-color: #292333;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: 30px;
}
