	Definir numero, usuarios, notificaciones, hora, total Como entero 
	Escribir "Elija numero de red social deseada"
	Escribir "Instagram"
	Escribir "Youtube"
	Escribir "Tiktok"
	leer numero
	Segun numero Hacer
		1:
			escribir "formato recomendado en Instagram: Vertical 9:16 1080 x 1920 píxeles"
		2:
			Escribir "formato recomendado para videos largos en Youtube: Horizontal 16:9 (1920 x 1080 px)."
		3:
			escribir "formato recomendado en Tiktok: Vertical 9:16, 1080 px por 1920 px."
