Algoritmo contador_de_elementoss
	definir i Como Entero
	definir contador, precio Como Real
	dimension precio[5]
	contador=0
	Para i=1 Hasta 5 Con Paso 1 Hacer
		escribir "ingresar precio de los siguientes 5 productos"
		leer precio[i]
		Si precio[i]>1000 Entonces
			cont=cont+1
		Fin Si
	Fin Para
	Escribir "Cantidad de productos por encima de 1000: ", cont
FinAlgoritmo
