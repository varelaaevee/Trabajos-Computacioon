body {
    background-color: #202020;
    color: #eeeeee;
    font-family: "sunday_ginger";
    margin: 0;
}

header {
    background-color: #181818;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 8%;
    border-bottom: 1px solid #444444;
}

header h2 {
    font-size: 22px;
    letter-spacing: 2px;
}

header a {
    color: #dddddd;
    text-decoration: none;
}

header a:hover {
    color: #999999;
}

.inicioo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    padding: 55px 8%;
    background-color: #1b1b1b;
    border-bottom: 1px solid #444444;
}

.texto-inicio {
    flex: 1;
}

.subtitulo {
    color: #999999;
    font-size: 12px;
    letter-spacing: 2px;
}

.inicioo h1 {
    font-size: 36px;
    max-width: 500px;
}

.descripcion {
    color: #bbbbbb;
    line-height: 1.6;
}

.enlace {
    display: inline-block;
    margin-top: 15px;
    padding: 10px 18px;
    border: 1px solid #777777;
    color: #eeeeee;
    text-decoration: none;
}

.enlace:hover {
    background-color: #333333;
}

.imagen-inicio {
    width: 100%;
    max-width: 400px;
    height: 230px;
    object-fit: cover;
    border: 1px solid #444444;
    filter: grayscale(100%);
}


.temas {
    display: none;
    padding: 35px 8%;
}

.temas h2 {
    font-size: 27px;
    margin-bottom: 10px;
}

.contenedor {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 25px;
}

.contenedor button {
    background-color: #292929;
    color: #eeeeee;
    border: 1px solid #444444;
    padding: 20px;
    min-height: 115px;
    font-size: 25px;
    cursor: pointer;
}

.contenedor button h3 {
    font-size: 16px;
    font-weight: normal;
    margin-bottom: 0;
}

.contenedor button:hover {
    background-color: #383838;
    border-color: #888888;
}

footer {
    background-color: #181818;
    color: #999999;
    text-align: center;
    padding: 18px;
    border-top: 1px solid #444444;
    font-size: 13px;
}

.temas button img {
    width: 100%;
    height: 75px;
    object-fit: cover;
    border-radius: 7px;
    filter: grayscale(100%);
    margin-bottom: 5px;
}


.temas button:hover img {
    filter: grayscale(40%);
}

